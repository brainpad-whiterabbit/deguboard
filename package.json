{
  "name": "deguboard",
  "version": "0.0.0",
  "private": true,
  "description": "Git-native な AI ワークフローとチケット管理。CLI は dg",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/web/tsconfig.json",
    "test": "vitest run",
    "check:docs": "node scripts/check-docs.mjs",
    "build": "tsc -b tsconfig.build.json && cp packages/cli/src/guide-*.md packages/cli/dist/ && pnpm --filter @deguboard/web build",
    "dg": "node packages/cli/bin/dg.js"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.12.1"
}
