{
  "name": "deguboard-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Agentic-Agile を実践するための Git-native なカンバン。CLI は dg",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/web/tsconfig.json && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "test:locked": "sh scripts/test-locked.sh vitest run",
    "test:related": "vitest run --changed origin/main --passWithNoTests",
    "test:layout": "vitest run --config vitest.layout.config.ts",
    "test:vscode": "vitest run --config vitest.vscode.config.ts",
    "test:docs": "vitest run test/scripts/check-docs.test.ts",
    "check:docs": "node scripts/check-docs.mjs",
    "build": "tsc -b tsconfig.build.json && mkdir -p packages/core/dist/guide && cp packages/core/src/guide/guide-*.md packages/core/dist/guide/ && pnpm --filter @deguboard/web build && rm -rf packages/cli/web && cp -r packages/web/dist packages/cli/web && pnpm --filter deguboard build",
    "dg": "node packages/cli/bin/dg.js",
    "link:dg": "node scripts/link-dg.mjs",
    "vsix": "pnpm --filter deguboard package && node scripts/vsix-sha256.mjs",
    "vsix:install": "node scripts/install-vsix.mjs",
    "playwright:install": "playwright-core install chromium chromium-headless-shell",
    "gifs": "node scripts/record-gifs.mjs",
    "release:version": "pnpm -r exec npm version --no-git-tag-version --allow-same-version",
    "audit": "pnpm audit --prod"
  },
  "devDependencies": {
    "@playwright/mcp": "0.0.85",
    "@types/node": "24.19.2",
    "@vscode/test-electron": "3.1.0",
    "gifenc": "1.0.3",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "playwright-core": "1.66.0-alpha-2026-11-09",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.12.1"
}
