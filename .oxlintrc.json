{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "env": {
    "builtin": true
  },
  "overrides": [
    {
      "files": ["packages/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@deguboard/*",
                  "deguboard",
                  "deguboard-vscode",
                  "vscode",
                  "react",
                  "react-dom",
                  "react-dom/*"
                ],
                "message": "core は何にも依存しない（ADR-007）"
              },
              {
                "regex": "^\\.\\.?/(\\.\\./)*(cli|server|web|vscode)(/|$)",
                "message": "core は他のパッケージを相対パスでも import しない（ADR-007）"
              },
              {
                "regex": "^\\.\\.?/(\\.\\./)*agents/adapters(/|$)",
                "message": "特定の AI 製品の Adapter は agents の外から import しない。agents/index.ts の一覧を通す（AG-5、ADR-007）"
              }
            ]
          }
        ]
      }
    },
    // Core の汎用部分（actions と index.ts の外のすべて）は actions に依存しない（AG-6）。index.ts は ACTION_NAMES を公開するので対象にしない。agents/adapters の禁止（AG-5）も写す。同じルールを上書きするので、上の packages/core/** の制限パターンを写している。上を変えたらここも揃える
    {
      "files": [
        "packages/core/src/commands/**",
        "packages/core/src/storage/**",
        "packages/core/src/workflow/**",
        "packages/core/src/model/**",
        "packages/core/src/git/**",
        "packages/core/src/run/**",
        "packages/core/src/agents/**",
        "packages/core/src/errors.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@deguboard/*",
                  "deguboard",
                  "deguboard-vscode",
                  "vscode",
                  "react",
                  "react-dom",
                  "react-dom/*"
                ],
                "message": "core は何にも依存しない（ADR-007）"
              },
              {
                "regex": "^\\.\\.?/(\\.\\./)*(cli|server|web|vscode)(/|$)",
                "message": "core は他のパッケージを相対パスでも import しない（ADR-007）"
              },
              {
                "regex": "^\\.\\.?/(\\.\\./)*agents/adapters(/|$)",
                "message": "特定の AI 製品の Adapter は agents の外から import しない。agents/index.ts の一覧を通す（AG-5、ADR-007）"
              },
              {
                "regex": "^\\.\\.?/(\\.\\./)*actions(/|$)",
                "message": "Core の汎用部分（actions と index.ts の外）は actions に依存しない（AG-6、ADR-007）"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/server/**", "packages/vscode/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@deguboard/*", "!@deguboard/core", "deguboard", "deguboard-vscode"],
                "message": "server と vscode は core だけに依存する（ADR-007）"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/cli/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@deguboard/*",
                  "!@deguboard/core",
                  "!@deguboard/server",
                  "deguboard-vscode"
                ],
                "message": "cli は core と server だけに依存する（ADR-007）"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/web/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@deguboard/*", "!@deguboard/core", "deguboard", "deguboard-vscode"],
                "message": "web は core だけに依存する（ADR-007）"
              },
              {
                "group": ["@deguboard/core"],
                "allowTypeImports": true,
                "message": "web は core から型だけを取り込む。実行時のコードは Vite が node のモジュールを束ねるので禁止（ADR-007）"
              }
            ]
          }
        ]
      }
    }
  ]
}
