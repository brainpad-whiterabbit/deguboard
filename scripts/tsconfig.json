{
  // scripts の .mjs を checkJs で検査する。型は JSDoc で書く。
  // check-docs.mjs と record-gifs.mjs は対象外にする。注釈のない引数と、ブラウザの中で動かす関数（DOM の型が要る）で
  // 200 件を超える誤りが出て、型のための注釈が本体より目立つため。2 つは mise run check:docs と GIF の録画を動かして確かめる。
  // scripts/lib の .mjs は、同じ名前の .d.mts があると tsc がそちらを読むので本体は検査されない。型の約束は .d.mts に書き、
  // 本体が約束どおりかは test/scripts のテストで確かめる
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true
  },
  "include": ["."],
  "exclude": ["check-docs.mjs", "record-gifs.mjs"]
}
