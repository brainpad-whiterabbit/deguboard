{
  "name": "@deguboard/server",
  "version": "0.0.0",
  "description": "deguboard の HTTP サーバー。core のコマンド定義を HTTP に写し、web を配信する",
  "homepage": "https://github.com/brainpad-whiterabbit/deguboard#readme",
  "bugs": "https://github.com/brainpad-whiterabbit/deguboard/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brainpad-whiterabbit/deguboard.git",
    "directory": "packages/server"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deguboard/core": "workspace:*",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=24"
  }
}
