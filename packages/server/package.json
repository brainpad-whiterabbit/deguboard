{
  "name": "@deguboard/server",
  "version": "0.30.0",
  "private": true,
  "description": "deguboard の HTTP サーバー。core のコマンド定義を HTTP に写し、web を配信する",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./defaults": {
      "development": "./src/defaults.ts",
      "types": "./dist/defaults.d.ts",
      "default": "./dist/defaults.js"
    }
  },
  "dependencies": {
    "@deguboard/core": "workspace:*",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=24"
  }
}
