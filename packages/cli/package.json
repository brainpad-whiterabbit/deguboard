{
  "name": "deguboard",
  "version": "0.20.0",
  "description": "The CLI (dg) of deguboard, a Git-native kanban board for practicing Agentic-Agile with AI agents. Tickets live as Markdown on the deguboard branch, and workflows for agents come with it (dg guide).",
  "keywords": [
    "ai-agent",
    "claude-code",
    "git",
    "kanban",
    "tickets",
    "workflow"
  ],
  "homepage": "https://github.com/brainpad-whiterabbit/deguboard#readme",
  "bugs": "https://github.com/brainpad-whiterabbit/deguboard/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brainpad-whiterabbit/deguboard.git",
    "directory": "packages/cli"
  },
  "bin": {
    "dg": "./bin/dg.js"
  },
  "files": [
    "bin",
    "dist",
    "!dist/guide-*.md",
    "web"
  ],
  "type": "module",
  "scripts": {
    "prepack": "cp ../../LICENSE LICENSE"
  },
  "dependencies": {
    "@deguboard/core": "workspace:*",
    "@deguboard/server": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "commander": "15.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=24"
  }
}
