{
  "name": "deguboard-vscode",
  "displayName": "deguboard",
  "version": "0.8.0",
  "private": true,
  "description": "deguboard の VS Code 拡張。Activity Bar のアイコンからサイドバーに web の画面を出し、拡張ホストから core を呼ぶ。dg は同梱しない",
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brainpad-whiterabbit/deguboard.git",
    "directory": "packages/vscode"
  },
  "publisher": "deguboard",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "vite build && rm -rf dist/web && cp -r ../web/dist dist/web",
    "package": "cp ../../LICENSE LICENSE && vsce package --no-dependencies --out deguboard-vscode.vsix"
  },
  "dependencies": {
    "@deguboard/core": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "1.120.0",
    "@vscode/vsce": "4.1.0",
    "vite": "8.3.5"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deguboard",
          "title": "deguboard",
          "icon": "media/deguboard.svg"
        }
      ]
    },
    "views": {
      "deguboard": [
        {
          "type": "webview",
          "id": "deguboard.screens",
          "name": "deguboard",
          "contextualTitle": "deguboard"
        }
      ]
    },
    "commands": [
      {
        "command": "deguboard.sync",
        "title": "同期",
        "category": "deguboard",
        "icon": "$(sync)"
      },
      {
        "command": "deguboard.config",
        "title": "設定",
        "category": "deguboard",
        "icon": "$(gear)"
      },
      {
        "command": "deguboard.backlog.moveIteration",
        "title": "Iteration を移す",
        "category": "deguboard"
      },
      {
        "command": "deguboard.backlog.openTicket",
        "title": "詳細を開く",
        "category": "deguboard"
      },
      {
        "command": "deguboard.backlog.copyId",
        "title": "ID をコピー",
        "category": "deguboard"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "deguboard.sync",
          "when": "view == deguboard.screens",
          "group": "navigation@1"
        },
        {
          "command": "deguboard.config",
          "when": "view == deguboard.screens",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "deguboard.sync",
          "when": "false"
        },
        {
          "command": "deguboard.config",
          "when": "false"
        },
        {
          "command": "deguboard.backlog.moveIteration",
          "when": "false"
        },
        {
          "command": "deguboard.backlog.openTicket",
          "when": "false"
        },
        {
          "command": "deguboard.backlog.copyId",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "deguboard.backlog.moveIteration",
          "when": "webviewId == 'deguboard.screens' && webviewSection == 'backlogTicket'",
          "group": "1_move@1"
        },
        {
          "command": "deguboard.backlog.openTicket",
          "when": "webviewId == 'deguboard.screens' && webviewSection == 'backlogTicket'",
          "group": "2_open@1"
        },
        {
          "command": "deguboard.backlog.copyId",
          "when": "webviewId == 'deguboard.screens' && webviewSection == 'backlogTicket'",
          "group": "9_copy@1"
        }
      ]
    }
  },
  "engines": {
    "vscode": "^1.123.0"
  }
}
