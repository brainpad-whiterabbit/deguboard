{
  "name": "deguboard-vscode",
  "displayName": "deguboard",
  "version": "0.11.0",
  "private": true,
  "description": "deguboard の VS Code 拡張。Activity Bar のアイコンからサイドバーに web の画面を出し、拡張ホストから core を呼ぶ。dg は同梱しない",
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brainpad-whiterabbit/deguboard.git",
    "directory": "packages/vscode"
  },
  "publisher": "deguboard",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "vite build && rm -rf dist/web && cp -r ../web/dist dist/web",
    "package": "cp ../../LICENSE LICENSE && vsce package --no-dependencies --out deguboard-vscode.vsix"
  },
  "dependencies": {
    "@deguboard/core": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "1.120.0",
    "@vscode/vsce": "4.1.0",
    "vite": "8.3.5"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deguboard",
          "title": "deguboard",
          "icon": "media/deguboard.svg"
        }
      ]
    },
    "views": {
      "deguboard": [
        {
          "type": "webview",
          "id": "deguboard.screens",
          "name": "deguboard",
          "contextualTitle": "deguboard"
        }
      ]
    },
    "commands": [
      {
        "command": "deguboard.sync",
        "title": "同期",
        "category": "deguboard",
        "icon": "$(sync)"
      },
      {
        "command": "deguboard.config",
        "title": "設定",
        "category": "deguboard",
        "icon": "$(gear)"
      },
      {
        "command": "deguboard.ask",
        "title": "エージェントに頼む",
        "category": "deguboard",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "deguboard.askInSidebar",
        "title": "エージェントに頼む",
        "category": "deguboard",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "deguboard.backlog.openTicket",
        "title": "詳細を開く",
        "category": "deguboard"
      },
      {
        "command": "deguboard.backlog.copyId",
        "title": "ID をコピー",
        "category": "deguboard"
      },
      {
        "command": "deguboard.ask.create",
        "title": "起票する",
        "category": "deguboard"
      },
      {
        "command": "deguboard.ask.create_iteration",
        "title": "Iteration を作る",
        "category": "deguboard"
      },
      {
        "command": "deguboard.ask.create_epic",
        "title": "Epic を作る",
        "category": "deguboard"
      },
      {
        "command": "deguboard.ask.fix",
        "title": "直す",
        "category": "deguboard"
      },
      {
        "command": "deguboard.ask.split",
        "title": "分ける",
        "category": "deguboard"
      },
      {
        "command": "deguboard.ask.remove",
        "title": "Iteration・Epic から外す",
        "category": "deguboard"
      },
      {
        "command": "deguboard.ask.edit",
        "title": "題・名前を直す",
        "category": "deguboard"
      },
      {
        "command": "deguboard.ask.assign",
        "title": "割り当てる",
        "category": "deguboard"
      },
      {
        "command": "deguboard.ask.plan",
        "title": "計画を立てる",
        "category": "deguboard"
      },
      {
        "command": "deguboard.ask.approve",
        "title": "承認する",
        "category": "deguboard"
      },
      {
        "command": "deguboard.ask.work",
        "title": "進める",
        "category": "deguboard"
      },
      {
        "command": "deguboard.ask.resume",
        "title": "再開する",
        "category": "deguboard"
      },
      {
        "command": "deguboard.ask.all",
        "title": "最後まで進める",
        "category": "deguboard"
      },
      {
        "command": "deguboard.ask.done",
        "title": "確かめて片付ける",
        "category": "deguboard"
      },
      {
        "command": "deguboard.ask.check",
        "title": "点検する",
        "category": "deguboard"
      },
      {
        "command": "deguboard.ask.release",
        "title": "リリースする",
        "category": "deguboard"
      },
      {
        "command": "deguboard.ask.close",
        "title": "閉じる",
        "category": "deguboard"
      },
      {
        "command": "deguboard.ask.reopen",
        "title": "再開する（閉じたもの）",
        "category": "deguboard"
      },
      {
        "command": "deguboard.ask.abandon",
        "title": "やめる",
        "category": "deguboard"
      },
      {
        "command": "deguboard.ask.undo_done",
        "title": "done を取り消す",
        "category": "deguboard"
      },
      {
        "command": "deguboard.ask.status",
        "title": "様子を聞く",
        "category": "deguboard"
      },
      {
        "command": "deguboard.ask.retro",
        "title": "振り返る",
        "category": "deguboard"
      },
      {
        "command": "deguboard.ask.free",
        "title": "自由に",
        "category": "deguboard"
      }
    ],
    "submenus": [
      {
        "id": "deguboard.askMenu",
        "label": "エージェントに頼む"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "deguboard.askInSidebar",
          "when": "view == deguboard.screens",
          "group": "navigation@0"
        },
        {
          "command": "deguboard.sync",
          "when": "view == deguboard.screens",
          "group": "navigation@1"
        },
        {
          "command": "deguboard.config",
          "when": "view == deguboard.screens",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "deguboard.sync",
          "when": "false"
        },
        {
          "command": "deguboard.config",
          "when": "false"
        },
        {
          "command": "deguboard.askInSidebar",
          "when": "false"
        },
        {
          "command": "deguboard.backlog.openTicket",
          "when": "false"
        },
        {
          "command": "deguboard.backlog.copyId",
          "when": "false"
        },
        {
          "command": "deguboard.ask.create",
          "when": "false"
        },
        {
          "command": "deguboard.ask.create_iteration",
          "when": "false"
        },
        {
          "command": "deguboard.ask.create_epic",
          "when": "false"
        },
        {
          "command": "deguboard.ask.fix",
          "when": "false"
        },
        {
          "command": "deguboard.ask.split",
          "when": "false"
        },
        {
          "command": "deguboard.ask.remove",
          "when": "false"
        },
        {
          "command": "deguboard.ask.edit",
          "when": "false"
        },
        {
          "command": "deguboard.ask.assign",
          "when": "false"
        },
        {
          "command": "deguboard.ask.plan",
          "when": "false"
        },
        {
          "command": "deguboard.ask.approve",
          "when": "false"
        },
        {
          "command": "deguboard.ask.work",
          "when": "false"
        },
        {
          "command": "deguboard.ask.resume",
          "when": "false"
        },
        {
          "command": "deguboard.ask.all",
          "when": "false"
        },
        {
          "command": "deguboard.ask.done",
          "when": "false"
        },
        {
          "command": "deguboard.ask.check",
          "when": "false"
        },
        {
          "command": "deguboard.ask.release",
          "when": "false"
        },
        {
          "command": "deguboard.ask.close",
          "when": "false"
        },
        {
          "command": "deguboard.ask.reopen",
          "when": "false"
        },
        {
          "command": "deguboard.ask.abandon",
          "when": "false"
        },
        {
          "command": "deguboard.ask.undo_done",
          "when": "false"
        },
        {
          "command": "deguboard.ask.status",
          "when": "false"
        },
        {
          "command": "deguboard.ask.retro",
          "when": "false"
        },
        {
          "command": "deguboard.ask.free",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "submenu": "deguboard.askMenu",
          "when": "(webviewId == 'deguboard.screens' || webviewId == 'deguboard') && askActions",
          "group": "0_ask@1"
        },
        {
          "command": "deguboard.backlog.openTicket",
          "when": "webviewId == 'deguboard.screens' && webviewSection == 'backlogTicket'",
          "group": "2_open@1"
        },
        {
          "command": "deguboard.backlog.copyId",
          "when": "webviewId == 'deguboard.screens' && webviewSection == 'backlogTicket'",
          "group": "9_copy@1"
        }
      ],
      "deguboard.askMenu": [
        {
          "command": "deguboard.ask.create",
          "when": "askRecommended == 'create'",
          "group": "1_recommended@1"
        },
        {
          "command": "deguboard.ask.create",
          "when": "askActions =~ /\\bcreate\\b/ && askRecommended != 'create'",
          "group": "2_more@1"
        },
        {
          "command": "deguboard.ask.create_iteration",
          "when": "askRecommended == 'create_iteration'",
          "group": "1_recommended@1"
        },
        {
          "command": "deguboard.ask.create_iteration",
          "when": "askActions =~ /\\bcreate_iteration\\b/ && askRecommended != 'create_iteration'",
          "group": "2_more@2"
        },
        {
          "command": "deguboard.ask.create_epic",
          "when": "askRecommended == 'create_epic'",
          "group": "1_recommended@1"
        },
        {
          "command": "deguboard.ask.create_epic",
          "when": "askActions =~ /\\bcreate_epic\\b/ && askRecommended != 'create_epic'",
          "group": "2_more@3"
        },
        {
          "command": "deguboard.ask.fix",
          "when": "askRecommended == 'fix'",
          "group": "1_recommended@1"
        },
        {
          "command": "deguboard.ask.fix",
          "when": "askActions =~ /\\bfix\\b/ && askRecommended != 'fix'",
          "group": "2_more@4"
        },
        {
          "command": "deguboard.ask.split",
          "when": "askRecommended == 'split'",
          "group": "1_recommended@1"
        },
        {
          "command": "deguboard.ask.split",
          "when": "askActions =~ /\\bsplit\\b/ && askRecommended != 'split'",
          "group": "2_more@5"
        },
        {
          "command": "deguboard.ask.remove",
          "when": "askRecommended == 'remove'",
          "group": "1_recommended@1"
        },
        {
          "command": "deguboard.ask.remove",
          "when": "askActions =~ /\\bremove\\b/ && askRecommended != 'remove'",
          "group": "2_more@6"
        },
        {
          "command": "deguboard.ask.edit",
          "when": "askRecommended == 'edit'",
          "group": "1_recommended@1"
        },
        {
          "command": "deguboard.ask.edit",
          "when": "askActions =~ /\\bedit\\b/ && askRecommended != 'edit'",
          "group": "2_more@7"
        },
        {
          "command": "deguboard.ask.assign",
          "when": "askRecommended == 'assign'",
          "group": "1_recommended@1"
        },
        {
          "command": "deguboard.ask.assign",
          "when": "askActions =~ /\\bassign\\b/ && askRecommended != 'assign'",
          "group": "2_more@8"
        },
        {
          "command": "deguboard.ask.plan",
          "when": "askRecommended == 'plan'",
          "group": "1_recommended@1"
        },
        {
          "command": "deguboard.ask.plan",
          "when": "askActions =~ /\\bplan\\b/ && askRecommended != 'plan'",
          "group": "2_more@9"
        },
        {
          "command": "deguboard.ask.approve",
          "when": "askRecommended == 'approve'",
          "group": "1_recommended@1"
        },
        {
          "command": "deguboard.ask.approve",
          "when": "askActions =~ /\\bapprove\\b/ && askRecommended != 'approve'",
          "group": "2_more@10"
        },
        {
          "command": "deguboard.ask.work",
          "when": "askRecommended == 'work'",
          "group": "1_recommended@1"
        },
        {
          "command": "deguboard.ask.work",
          "when": "askActions =~ /\\bwork\\b/ && askRecommended != 'work'",
          "group": "2_more@11"
        },
        {
          "command": "deguboard.ask.resume",
          "when": "askRecommended == 'resume'",
          "group": "1_recommended@1"
        },
        {
          "command": "deguboard.ask.resume",
          "when": "askActions =~ /\\bresume\\b/ && askRecommended != 'resume'",
          "group": "2_more@12"
        },
        {
          "command": "deguboard.ask.all",
          "when": "askRecommended == 'all'",
          "group": "1_recommended@1"
        },
        {
          "command": "deguboard.ask.all",
          "when": "askActions =~ /\\ball\\b/ && askRecommended != 'all'",
          "group": "2_more@13"
        },
        {
          "command": "deguboard.ask.done",
          "when": "askRecommended == 'done'",
          "group": "1_recommended@1"
        },
        {
          "command": "deguboard.ask.done",
          "when": "askActions =~ /\\bdone\\b/ && askRecommended != 'done'",
          "group": "2_more@14"
        },
        {
          "command": "deguboard.ask.check",
          "when": "askRecommended == 'check'",
          "group": "1_recommended@1"
        },
        {
          "command": "deguboard.ask.check",
          "when": "askActions =~ /\\bcheck\\b/ && askRecommended != 'check'",
          "group": "2_more@15"
        },
        {
          "command": "deguboard.ask.release",
          "when": "askRecommended == 'release'",
          "group": "1_recommended@1"
        },
        {
          "command": "deguboard.ask.release",
          "when": "askActions =~ /\\brelease\\b/ && askRecommended != 'release'",
          "group": "2_more@16"
        },
        {
          "command": "deguboard.ask.close",
          "when": "askRecommended == 'close'",
          "group": "1_recommended@1"
        },
        {
          "command": "deguboard.ask.close",
          "when": "askActions =~ /\\bclose\\b/ && askRecommended != 'close'",
          "group": "2_more@17"
        },
        {
          "command": "deguboard.ask.reopen",
          "when": "askRecommended == 'reopen'",
          "group": "1_recommended@1"
        },
        {
          "command": "deguboard.ask.reopen",
          "when": "askActions =~ /\\breopen\\b/ && askRecommended != 'reopen'",
          "group": "2_more@18"
        },
        {
          "command": "deguboard.ask.abandon",
          "when": "askRecommended == 'abandon'",
          "group": "1_recommended@1"
        },
        {
          "command": "deguboard.ask.abandon",
          "when": "askActions =~ /\\babandon\\b/ && askRecommended != 'abandon'",
          "group": "2_more@19"
        },
        {
          "command": "deguboard.ask.undo_done",
          "when": "askRecommended == 'undo_done'",
          "group": "1_recommended@1"
        },
        {
          "command": "deguboard.ask.undo_done",
          "when": "askActions =~ /\\bundo_done\\b/ && askRecommended != 'undo_done'",
          "group": "2_more@20"
        },
        {
          "command": "deguboard.ask.status",
          "when": "askRecommended == 'status'",
          "group": "1_recommended@1"
        },
        {
          "command": "deguboard.ask.status",
          "when": "askActions =~ /\\bstatus\\b/ && askRecommended != 'status'",
          "group": "2_more@21"
        },
        {
          "command": "deguboard.ask.retro",
          "when": "askRecommended == 'retro'",
          "group": "1_recommended@1"
        },
        {
          "command": "deguboard.ask.retro",
          "when": "askActions =~ /\\bretro\\b/ && askRecommended != 'retro'",
          "group": "2_more@22"
        },
        {
          "command": "deguboard.ask.free",
          "when": "askRecommended == 'free'",
          "group": "1_recommended@1"
        },
        {
          "command": "deguboard.ask.free",
          "when": "askActions =~ /\\bfree\\b/ && askRecommended != 'free'",
          "group": "2_more@23"
        }
      ]
    }
  },
  "engines": {
    "vscode": "^1.123.0"
  }
}
