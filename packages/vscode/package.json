{
  "name": "deguboard-vscode",
  "displayName": "deguboard",
  "version": "0.15.0",
  "private": true,
  "description": "AI エージェントに仕事を任せるためのカンバン。小さなチケットに分けて並列に進め、その働きを測れます。",
  "categories": [
    "AI",
    "Other",
    "Visualization"
  ],
  "keywords": [
    "ai agent",
    "claude code",
    "codex",
    "copilot",
    "git",
    "kanban",
    "ticket",
    "カンバン"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brainpad-whiterabbit/deguboard.git",
    "directory": "packages/vscode"
  },
  "publisher": "deguboard",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "vite build && rm -rf dist/web && cp -r ../web/dist dist/web",
    "package": "node ../../scripts/vscode-readme.mjs && cp ../../LICENSE LICENSE && vsce package --no-dependencies --out deguboard-vscode.vsix"
  },
  "dependencies": {
    "@deguboard/core": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "1.120.0",
    "@vscode/vsce": "4.1.0",
    "vite": "8.3.5"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deguboard",
          "title": "deguboard",
          "icon": "media/deguboard.svg"
        }
      ]
    },
    "views": {
      "deguboard": [
        {
          "type": "webview",
          "id": "deguboard.screens",
          "name": "deguboard",
          "contextualTitle": "deguboard"
        }
      ]
    },
    "commands": [
      {
        "command": "deguboard.sync",
        "title": "同期",
        "category": "deguboard",
        "icon": "$(sync)"
      },
      {
        "command": "deguboard.config",
        "title": "設定",
        "category": "deguboard",
        "icon": "$(gear)"
      },
      {
        "command": "deguboard.ask",
        "title": "エージェントに頼む",
        "category": "deguboard",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "deguboard.askInSidebar",
        "title": "エージェントに頼む",
        "category": "deguboard",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "deguboard.backlog.openTicket",
        "title": "詳細を開く",
        "category": "deguboard"
      },
      {
        "command": "deguboard.backlog.copyId",
        "title": "ID をコピー",
        "category": "deguboard"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "deguboard.askInSidebar",
          "when": "view == deguboard.screens",
          "group": "navigation@0"
        },
        {
          "command": "deguboard.sync",
          "when": "view == deguboard.screens",
          "group": "navigation@1"
        },
        {
          "command": "deguboard.config",
          "when": "view == deguboard.screens",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "deguboard.sync",
          "when": "false"
        },
        {
          "command": "deguboard.config",
          "when": "false"
        },
        {
          "command": "deguboard.askInSidebar",
          "when": "false"
        },
        {
          "command": "deguboard.backlog.openTicket",
          "when": "false"
        },
        {
          "command": "deguboard.backlog.copyId",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "deguboard.backlog.openTicket",
          "when": "webviewId == 'deguboard.screens' && webviewSection == 'backlogTicket'",
          "group": "2_open@1"
        },
        {
          "command": "deguboard.backlog.copyId",
          "when": "webviewId == 'deguboard.screens' && webviewSection == 'backlogTicket'",
          "group": "9_copy@1"
        }
      ]
    }
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#161b23",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.123.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "deguboard はワークスペースのリポジトリで git を実行します。リポジトリの git の設定（core.fsmonitor など）は任意のコマンドを実行させ得るため、信頼していないフォルダー（制限モード）では動きません。"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "deguboard はローカルのファイルシステムと git のコマンドを使うため、仮想ワークスペースでは動きません。"
    }
  }
}
