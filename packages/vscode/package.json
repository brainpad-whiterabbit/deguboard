{
  "name": "deguboard-vscode",
  "displayName": "deguboard",
  "version": "0.20.0",
  "private": true,
  "description": "%description%",
  "categories": [
    "AI",
    "Other",
    "Visualization"
  ],
  "keywords": [
    "ai agent",
    "claude code",
    "codex",
    "copilot",
    "git",
    "kanban",
    "ticket",
    "カンバン"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brainpad-whiterabbit/deguboard.git",
    "directory": "packages/vscode"
  },
  "publisher": "deguboard",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "vite build && rm -rf dist/web && cp -r ../web/dist dist/web && cp ../core/src/guide/guide-*.md dist/",
    "package": "node ../../scripts/vscode-readme.mjs && cp ../../LICENSE LICENSE && vsce package --no-dependencies --out deguboard-vscode.vsix"
  },
  "dependencies": {
    "@deguboard/core": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "1.120.0",
    "@vscode/vsce": "4.1.0",
    "vite": "8.3.6"
  },
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deguboard",
          "title": "deguboard",
          "icon": "media/deguboard.svg"
        }
      ]
    },
    "views": {
      "deguboard": [
        {
          "type": "webview",
          "id": "deguboard.screens",
          "name": "deguboard",
          "contextualTitle": "deguboard"
        }
      ]
    },
    "commands": [
      {
        "command": "deguboard.gotoTicket",
        "title": "%command.gotoTicket.title%",
        "category": "deguboard"
      },
      {
        "command": "deguboard.sync",
        "title": "%command.sync.title%",
        "category": "deguboard",
        "icon": "$(sync)"
      },
      {
        "command": "deguboard.config",
        "title": "%command.config.title%",
        "category": "deguboard",
        "icon": "$(gear)"
      },
      {
        "command": "deguboard.ask",
        "title": "%command.ask.title%",
        "category": "deguboard",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "deguboard.askInSidebar",
        "title": "%command.askInSidebar.title%",
        "category": "deguboard",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "deguboard.backlog.openTicket",
        "title": "%command.backlog.openTicket.title%",
        "category": "deguboard"
      },
      {
        "command": "deguboard.backlog.copyId",
        "title": "%command.backlog.copyId.title%",
        "category": "deguboard"
      }
    ],
    "keybindings": [
      {
        "command": "deguboard.gotoTicket",
        "key": "ctrl+k ctrl+alt+g",
        "mac": "cmd+k alt+cmd+g"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "deguboard.askInSidebar",
          "when": "view == deguboard.screens",
          "group": "navigation@0"
        },
        {
          "command": "deguboard.sync",
          "when": "view == deguboard.screens",
          "group": "navigation@1"
        },
        {
          "command": "deguboard.config",
          "when": "view == deguboard.screens",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "deguboard.sync",
          "when": "false"
        },
        {
          "command": "deguboard.config",
          "when": "false"
        },
        {
          "command": "deguboard.askInSidebar",
          "when": "false"
        },
        {
          "command": "deguboard.backlog.openTicket",
          "when": "false"
        },
        {
          "command": "deguboard.backlog.copyId",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "deguboard.backlog.openTicket",
          "when": "webviewId == 'deguboard.screens' && webviewSection == 'backlogTicket'",
          "group": "2_open@1"
        },
        {
          "command": "deguboard.backlog.copyId",
          "when": "webviewId == 'deguboard.screens' && webviewSection == 'backlogTicket'",
          "group": "9_copy@1"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "deguboard.start",
        "title": "%walkthrough.start.title%",
        "description": "%walkthrough.start.description%",
        "steps": [
          {
            "id": "deguboard.start.init",
            "title": "%walkthrough.start.init.title%",
            "description": "%walkthrough.start.init.description%",
            "media": {
              "markdown": "%walkthrough.start.init.markdown%"
            }
          },
          {
            "id": "deguboard.start.ticket",
            "title": "%walkthrough.start.ticket.title%",
            "description": "%walkthrough.start.ticket.description%",
            "media": {
              "markdown": "%walkthrough.start.ticket.markdown%"
            }
          },
          {
            "id": "deguboard.start.agent",
            "title": "%walkthrough.start.agent.title%",
            "description": "%walkthrough.start.agent.description%",
            "media": {
              "markdown": "%walkthrough.start.agent.markdown%"
            }
          }
        ]
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#161b23",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.123.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces.description%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces.description%"
    }
  }
}
