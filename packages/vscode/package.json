{
  "name": "deguboard-vscode",
  "displayName": "deguboard",
  "version": "0.1.0",
  "private": true,
  "description": "deguboard の VS Code 拡張。Activity Bar のアイコンからサイドバーに web の画面を出し、拡張ホストから core を呼ぶ。dg は同梱しない",
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brainpad-whiterabbit/deguboard.git",
    "directory": "packages/vscode"
  },
  "publisher": "deguboard",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "vite build && rm -rf dist/web && cp -r ../web/dist dist/web",
    "package": "vsce package --no-dependencies --skip-license --out deguboard-vscode.vsix"
  },
  "dependencies": {
    "@deguboard/core": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "1.104.0",
    "@vscode/vsce": "4.1.0",
    "vite": "8.3.5"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deguboard",
          "title": "deguboard",
          "icon": "media/deguboard.svg"
        }
      ]
    },
    "views": {
      "deguboard": [
        {
          "type": "webview",
          "id": "deguboard.screens",
          "name": "deguboard",
          "contextualTitle": "deguboard"
        }
      ]
    },
    "commands": [
      {
        "command": "deguboard.open",
        "title": "画面を開く",
        "category": "deguboard"
      },
      {
        "command": "deguboard.reload",
        "title": "再読み込み",
        "category": "deguboard",
        "icon": "$(refresh)"
      },
      {
        "command": "deguboard.sync",
        "title": "同期",
        "category": "deguboard",
        "icon": "$(sync)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "deguboard.reload",
          "when": "view == deguboard.screens",
          "group": "navigation@1"
        },
        {
          "command": "deguboard.sync",
          "when": "view == deguboard.screens",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "deguboard.reload",
          "when": "false"
        },
        {
          "command": "deguboard.sync",
          "when": "false"
        }
      ]
    }
  },
  "engines": {
    "vscode": "^1.104.0"
  }
}
